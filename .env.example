# ==============================================================================
#  BotYalla — Environment Configuration Example (.env.example)
#  نموذج إعدادات البيئة لمنصة BotYalla
# ------------------------------------------------------------------------------
#  طريقة الاستخدام:
#  1. انسخ هذا الملف إلى .env:
#     - Linux/macOS: cp .env.example .env
#     - Windows: copy .env.example .env
#  2. قم بتعديل القيم أدناه وتوليد سر تشفير قوي.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الأمان والجلسات (Security & Sessions)
# ------------------------------------------------------------------------------
# مفتاح تشفير الجلسات (قم بتوليد مفتاح عشوائي فريد)
# لتوليد مفتاح قوي عبر سطر الأوامر:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your_long_random_flask_secret_key_here

# مفتاح تشفير توكنات البوتات في القاعدة (Fernet). **احتفظ بنسخة منه مع .env** —
# ضياعه يعني أن توكنات البوتات المخزّنة لا تُقرأ (يُعاد ربط كل بوت).
# بدونه يُولَّد ملف `.token.key` بجانب القاعدة تلقائياً (خارج Git، ويُنسخ احتياطياً).
# لتوليد مفتاح:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# تفعيل حماية الكوكيز عبر HTTPS
# 0 = محلياً (HTTP)
# 1 = على السيرفر (HTTPS)
COOKIE_SECURE=0


# ------------------------------------------------------------------------------
# 2. حساب المالك / الأدمن الافتراضي (Default Admin Account)
# ------------------------------------------------------------------------------
# يُنشأ الحساب تلقائياً عند أول تشغيل فقط في حال كانت قاعدة البيانات فارغة.
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password_here


# ------------------------------------------------------------------------------
# 3. إعدادات الخادم المحلي (Local Server Settings - Optional)
# ------------------------------------------------------------------------------
# تُقرأ فقط عند التشغيل المباشر: python app.py
# في الإنتاج العنوان والمنفذ من gunicorn_conf.py لا من هنا.
PORT=5000
HOST=127.0.0.1


# ------------------------------------------------------------------------------
# 4. مفاتيح الذكاء الاصطناعي (AI Provider API Keys)
# ------------------------------------------------------------------------------
# لا تُضبط هنا. مفتاح الـ AI على مستوى المنصة ويُدار من صفحة «الإعدادات»
# (أدمن فقط) ويُخزَّن في جدول platform — راجع AGENTS.md §3.4.


# ------------------------------------------------------------------------------
# 5. الرابط العام والإيميل (Public URL & Email)
# ------------------------------------------------------------------------------
# أصل الموقع كما يراه العميل — تُبنى منه روابط الإيميل (استرجاع كلمة المرور).
# بدونه لا يُرسل أي رابط استرجاع عمداً: لا يُبنى رابط من ترويسة Host أبداً.
PUBLIC_URL=https://botyalla.example

# SMTP للإرسال (Brevo مثلاً — لا Gmail شخصي)، والاستقبال على صندوق الدعم (info@).
# بلا SMTP_HOST و SMTP_FROM لا يُرسل أي إيميل، ويستمر كل شيء آخر طبيعياً.
# عنوان no-reply لا يحتاج صندوقاً — يكفي توثيق الدومين في Brevo. الخطوات: docs/EMAIL_DNS.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BotYalla <no-reply@botyalla.example>
# starttls (منفذ 587) | ssl (منفذ 465) | none
SMTP_TLS=starttls
# أين تذهب ردود العملاء (المرسل no-reply). اختياري — الافتراضي إيميل الدعم في إعدادات المنصة.
SMTP_REPLY_TO=info@botyalla.example

# الدخول بجوجل وفيسبوك (اختياري) — بلا المفتاحين لا يظهر الزر. الخطوات: docs/SOCIAL_LOGIN.md
# عنوان الرجوع عند المزوّد: {PUBLIC_URL}/auth/google/callback · {PUBLIC_URL}/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# رمز التحقق من Google Search Console (اختياري) — يظهر كوسم meta في الصفحات العامة.
# غير مطلوب إن كان التحقق تمّ عبر DNS (سجل TXT على الدومين) — وهو الأفضل لأنه
# يغطي النطاق كله بما فيه النطاقات الفرعية، ولا يعتمد على وسم في الصفحة.
GOOGLE_SITE_VERIFICATION=


# ------------------------------------------------------------------------------
# 6. القياس والتتبّع (Analytics)
# ------------------------------------------------------------------------------
# القاعدة: **بلا معرّف لا يُحقن سكربت ولا تُفتح CSP.** كل أداة تفتح نطاقاتها هي
# وحدها (راجع analytics.py · csp_sources)، فضبط Clarity لا يفتح نطاقات فيسبوك.
# بعد أي تعديل هنا: sudo systemctl restart botyalla — السياسة تُبنى عند الإقلاع.
#
# وضعان لا ثالث لهما:
#   • GTM_ID مضبوط  → يُحقن GTM وحده، وتوضع بقية الوسوم **داخل الحاوية**.
#                      اضبط رغم ذلك بقية المعرّفات هنا: تُقرأ لتوسيع CSP فقط،
#                      وبدونها ستُحجب وسوم الحاوية بصمت.
#   • GTM_ID فارغ    → كل أداة مضبوطة تُحقن بسكربتها المباشر.
#
# ⚠️ لا تُضِف 'unsafe-inline' إلى script-src مهما اقترح المزوّد: كل سكربتاتنا
# (وGTM) تحمل nonce، وفتحه يُبطل حماية REVIEW.md §3.1 ويعيد ثغرة الحقن.
GTM_ID=
GA4_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
CLARITY_ID=

# الأحداث المُرسَلة تلقائياً: sign_up · bot_created · view_pricing ·
# subscribe_intent · subscribe_submit · purchase · whatsapp_click
# `purchase` يُطلق عند **تفعيل** الاشتراك فعلاً (بعد موافقة الأدمن) لا عند رفع
# الإيصال — ويصل العميل على أول صفحة يفتحها بعد التفعيل.
# المؤشر الحاسم: bot_created ÷ sign_up. تحت 50% أوقف الإنفاق وأصلح الـonboarding.


# ------------------------------------------------------------------------------
# 7. الحسابات الاجتماعية (اختياري)
# ------------------------------------------------------------------------------
# روابط كاملة بـ https مفصولة بفواصل. تظهر في تذييل الموقع وفي `sameAs` داخل
# البيانات المنظّمة — فيعرف جوجل أن الحسابات كلها لكيان واحد. النطاقات المقبولة
# فقط تُعرض (facebook · instagram · tiktok · linkedin · youtube · t.me · x ·
# wa.me · github)؛ ما عداها يُتجاهل بهدوء.
# اتركه فارغاً حتى تُنشأ الحسابات فعلاً — رابط لحساب غير موجود أسوأ من غيابه.
SOCIAL_LINKS=
