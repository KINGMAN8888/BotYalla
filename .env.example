# ==============================================================================
#  BotYalla — Environment Configuration Example (.env.example)
#  نموذج إعدادات البيئة لمنصة BotYalla
# ------------------------------------------------------------------------------
#  طريقة الاستخدام:
#  1. انسخ هذا الملف إلى .env:
#     - Linux/macOS: cp .env.example .env
#     - Windows: copy .env.example .env
#  2. قم بتعديل القيم أدناه وتوليد سر تشفير قوي.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الأمان والجلسات (Security & Sessions)
# ------------------------------------------------------------------------------
# مفتاح تشفير الجلسات (قم بتوليد مفتاح عشوائي فريد)
# لتوليد مفتاح قوي عبر سطر الأوامر:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your_long_random_flask_secret_key_here

# مفتاح تشفير توكنات البوتات في القاعدة (Fernet). **احتفظ بنسخة منه مع .env** —
# ضياعه يعني أن توكنات البوتات المخزّنة لا تُقرأ (يُعاد ربط كل بوت).
# بدونه يُولَّد ملف `.token.key` بجانب القاعدة تلقائياً (خارج Git، ويُنسخ احتياطياً).
# لتوليد مفتاح:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# تفعيل حماية الكوكيز عبر HTTPS
# 0 = محلياً (HTTP)
# 1 = على السيرفر (HTTPS)
COOKIE_SECURE=0


# ------------------------------------------------------------------------------
# 2. حساب المالك / الأدمن الافتراضي (Default Admin Account)
# ------------------------------------------------------------------------------
# يُنشأ الحساب تلقائياً عند أول تشغيل فقط في حال كانت قاعدة البيانات فارغة.
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password_here


# ------------------------------------------------------------------------------
# 3. إعدادات الخادم المحلي (Local Server Settings - Optional)
# ------------------------------------------------------------------------------
# تُقرأ فقط عند التشغيل المباشر: python app.py
# في الإنتاج العنوان والمنفذ من gunicorn_conf.py لا من هنا.
PORT=5000
HOST=127.0.0.1


# ------------------------------------------------------------------------------
# 4. مفاتيح الذكاء الاصطناعي (AI Provider API Keys)
# ------------------------------------------------------------------------------
# لا تُضبط هنا. مفتاح الـ AI على مستوى المنصة ويُدار من صفحة «الإعدادات»
# (أدمن فقط) ويُخزَّن في جدول platform — راجع AGENTS.md §3.4.


# ------------------------------------------------------------------------------
# 5. الرابط العام والإيميل (Public URL & Email)
# ------------------------------------------------------------------------------
# أصل الموقع كما يراه العميل — تُبنى منه روابط الإيميل (استرجاع كلمة المرور).
# بدونه لا يُرسل أي رابط استرجاع عمداً: لا يُبنى رابط من ترويسة Host أبداً.
PUBLIC_URL=https://botyalla.example

# SMTP (Zoho Mail أو Brevo مثلاً — لا Gmail شخصي). بلا SMTP_HOST و SMTP_FROM
# لا يُرسل أي إيميل، ويستمر كل شيء آخر طبيعياً.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BotYalla <no-reply@botyalla.example>
# starttls (منفذ 587) | ssl (منفذ 465) | none
SMTP_TLS=starttls

# رمز التحقق من Google Search Console (اختياري) — يظهر كوسم meta في الصفحات العامة
GOOGLE_SITE_VERIFICATION=
