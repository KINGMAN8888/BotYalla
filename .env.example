# ==============================================================================
#  BotYalla — Environment Configuration Example (.env.example)
#  نموذج إعدادات البيئة لمنصة BotYalla
# ------------------------------------------------------------------------------
#  طريقة الاستخدام:
#  1. انسخ هذا الملف إلى .env:
#     - Linux/macOS: cp .env.example .env
#     - Windows: copy .env.example .env
#  2. قم بتعديل القيم أدناه وتوليد سر تشفير قوي.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الأمان والجلسات (Security & Sessions)
# ------------------------------------------------------------------------------
# مفتاح تشفير الجلسات (قم بتوليد مفتاح عشوائي فريد)
# لتوليد مفتاح قوي عبر سطر الأوامر:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your_long_random_flask_secret_key_here

# تفعيل حماية الكوكيز عبر HTTPS
# 0 = محلياً (HTTP)
# 1 = على السيرفر (HTTPS)
COOKIE_SECURE=0


# ------------------------------------------------------------------------------
# 2. حساب المالك / الأدمن الافتراضي (Default Admin Account)
# ------------------------------------------------------------------------------
# يُنشأ الحساب تلقائياً عند أول تشغيل فقط في حال كانت قاعدة البيانات فارغة.
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password_here


# ------------------------------------------------------------------------------
# 3. إعدادات الخادم المحلي (Local Server Settings - Optional)
# ------------------------------------------------------------------------------
PORT=5000
HOST=127.0.0.1


# ------------------------------------------------------------------------------
# 4. مفاتيح الذكاء الاصطناعي (AI Provider API Keys - Optional)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# GROQ_API_KEY=
