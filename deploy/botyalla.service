[Unit]
Description=BotYalla SaaS (Gunicorn)
Documentation=https://github.com/KINGMAN8888/BotYalla
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botyalla
Group=botyalla
WorkingDirectory=/opt/botyalla
# /usr/bin ضروري: قراءة إيصالات الدفع تشغّل برنامج tesseract من هناك
Environment="PATH=/opt/botyalla/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/opt/botyalla/.env
ExecStart=/opt/botyalla/venv/bin/gunicorn -c gunicorn_conf.py wsgi:app

# إعادة التشغيل عند أي سقوط، مع كبح لمنع حلقة إعادة تشغيل سريعة
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# مهلة كافية لإيقاف بوتات تليجرام بهدوء قبل القتل
TimeoutStopSec=30
KillSignal=SIGTERM

# ---- تصلّب: العملية تتعامل مع مدفوعات ورفع ملفات ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# المسارات الوحيدة القابلة للكتابة: قاعدة البيانات والإيصالات والسجلات
ReadWritePaths=/opt/botyalla /var/log/botyalla

# السجلات إلى journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botyalla

[Install]
WantedBy=multi-user.target
